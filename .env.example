# ---------------------------------------------------------------- app
APP_NAME="Smart Stock Alert API"
ENVIRONMENT=local            # local | staging | production
PORT=7001
LOG_LEVEL=debug              # trace | debug | info | warn | error | fatal
TIMEZONE=Asia/Vientiane      # business calendar for CUS/RC daily codes
API_PREFIX=api/v1
CORS_ORIGINS=*               # comma separated, e.g. https://bo.example.com,https://owner.example.com

# ---------------------------------------------------------------- database (PostgreSQL)
# Same schema as smart-stock-alert-api: both APIs can share one database.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_stock_alert
DB_USER=postgres
DB_PASSWORD=
DB_POOL_MAX=10
DB_LOG_QUERIES=false

# ---------------------------------------------------------------- uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# ---------------------------------------------------------------- redis (cache, rate limit, logout)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
REDIS_PREFIX=smartstock:
REDIS_TIMEOUT_MS=1000
REDIS_RETRY_AFTER_SECONDS=10
CACHE_TTL_SECONDS=120

RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_LOGIN_IP_PER_MINUTE=20

# ---------------------------------------------------------------- auth (JWT)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use the SAME value as smart-stock-alert-api to share tokens between both APIs.
JWT_SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
